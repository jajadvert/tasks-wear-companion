<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="org.tasks.permission.READ_TASKS" />
    <uses-permission android:name="org.tasks.permission.WRITE_TASKS" />

    <application
        android:name=".BridgeApp"
        android:allowBackup="false"
        android:label="@string/app_name">

        <service
            android:name=".PhoneBridgeService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" />
            </intent-filter>
        </service>

        <!-- Advertise reachability so the wear side can find this phone via CapabilityClient. -->
        <meta-data
            android:name="com.google.android.gms.wearable.CAPABILITY"
            android:value="org.tasks.phone.bridge" />
    </application>
</manifest>
